{
  "enabled": true,
  "name": "RTK Rewrite",
  "description": "Sugere equivalentes rtk para comandos shell, economizando 60-90% de tokens.",
  "version": 1,
  "when": {
    "type": "PreToolUse",
    "matcher": "executeBash"
  },
  "then": {
    "type": "command",
    "command": "rtk hook kiro"
  }
}
